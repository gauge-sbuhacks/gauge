# copy this to .env.local and fill in what you have. everything is optional on your own machine:
# with nothing set, the app uses MongoDB on this computer and the "local dev user" (no sign-in).
# on vercel, set the same names under Project Settings > Environment Variables.

# ---------- database ----------
# MongoDB Atlas connection string. leave blank locally to use mongodb://127.0.0.1:27017/gauge
MONGODB_URI=

# ---------- sign-in (clerk) ----------
# all three together. the VITE_ one is read by the browser, the other two by the api
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---------- data providers (optional) ----------
# home value estimates. free plan is 50 requests a month
RENTCAST_API_KEY=
# vehicle retail/trade-in values. Enable Market Values plus Specifications / Vehicle Selections
# for VIN-free estimates. Two price requests plus one cached selections request without a VIN.
VINAUDIT_API_KEY=
# Server-only random secret for Vercel's daily check of monthly vehicle updates.
# Set the same value in the Production environment before deploying; never use a VITE_ prefix.
CRON_SECRET=

# Historical metal benchmarks (gold-api.com free plan: 10 history/OHLC requests per hour)
# Server only. Daily prices are cached for 24 hours. MTGJSON history needs no key.
GOLD_API_KEY=

# eBay production credentials for comparable active listing research
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# photo identification. https://aistudio.google.com/apikey
# photos themselves are stored in MongoDB for the signed-in account
GEMINI_API_KEY=
# watch asking-price averages by reference. https://www.thewatchapi.com/documentation
THEWATCH_API_KEY=
# alias accepted by the server if you already use this name:
# THEWATCHAPI_TOKEN=

# ---------- preview deploys only ----------
# true = skip sign-in on vercel. everyone shares one account, so only for test data
GAUGE_ALLOW_DEV_AUTH=

# api port for npm run dev (vite proxies /api here)
API_PORT=3180
