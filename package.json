{
    "name": "gauge",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "a net-worth tracker for the things you can touch",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
        "dev:web": "vite",
        "dev:api": "tsx watch --clear-screen=false server/dev.ts",
        "build": "tsc -b && vite build",
        "typecheck": "tsc -b",
        "preview": "vite preview",
        "lint": "oxlint"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/express": "^5.0.6",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.6",
        "oxlint": "^1.89.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "vite": "^8.3.5"
    },
    "dependencies": {
        "@clerk/express": "^2.1.83",
        "@clerk/react": "^6.18.1",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@hookform/resolvers": "^5.9.2",
        "@react-pdf/renderer": "^4.9.0",
        "@tanstack/react-query": "^5.104.5",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.0",
        "express": "^5.3.0",
        "lucide-react": "^1.61.0",
        "mongoose": "^9.11.4",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.91.0",
        "react-router": "^8.5.0",
        "recharts": "^3.10.1",
        "shadcn": "^4.22.1",
        "sonner": "^2.0.8",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    }
}
